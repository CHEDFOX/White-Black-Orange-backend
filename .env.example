# ---------------------------------------------------------------------------
# Stock Intelligence Platform -- backend configuration
# Copy to .env and adjust. Every provider credential stays on the backend;
# nothing in this file is ever sent to the browser.
# ---------------------------------------------------------------------------

ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true

# --- database --------------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/sip
DATABASE_ECHO=false

# --- redis / background jobs ----------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- market data providers -------------------------------------------------
# Comma-separated, highest priority first. A provider whose credential
# requirement is unmet is skipped and the reason is reported by
# GET /api/v1/data-sources.
MARKET_DATA_PROVIDERS=eodhd,yahoo_chart

# EODHD (primary). Official documented API. The literal token "demo" works for
# AAPL.US, MSFT.US, TSLA.US, AMZN.US, VTI.US, BTC-USD.CC and EURUSD.FOREX, so a
# fresh checkout has real data with no signup. Set a real key for full coverage.
EODHD_API_KEY=demo
EODHD_ENABLED=true
EODHD_RATE_LIMIT_PER_MINUTE=50

# Yahoo chart endpoint (fallback). Unofficial, unlicensed for redistribution,
# and rate-limited aggressively per IP -- hence the low default.
YAHOO_ENABLED=true
YAHOO_RATE_LIMIT_PER_MINUTE=5

# Licensed alternatives: set a key and add the provider id to
# MARKET_DATA_PROVIDERS once its adapter is implemented.
# TIINGO_API_KEY=
# POLYGON_API_KEY=
# ALPHA_VANTAGE_API_KEY=

# --- macro data (FRED / ALFRED) -------------------------------------------
# WITHOUT a key only the LATEST REVISION of each series is available, so
# historical macro analysis uses revised figures and says so. WITH a key the
# adapter uses ALFRED realtime windows and returns genuine vintages -- the
# numbers as first published. Free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_ENABLED=true
# FRED_API_KEY=

# --- fundamentals (SEC EDGAR) ---------------------------------------------
# The SEC requires a descriptive User-Agent with real contact details and a
# request rate at or below 10/s. Anonymous clients get throttled or blocked.
SEC_ENABLED=true
SEC_USER_AGENT=StockIntelligencePlatform/0.1 (you@example.com)
SEC_RATE_LIMIT_PER_SECOND=8

# --- LLM (optional) --------------------------------------------------------
# The LLM only paraphrases findings the engines already computed. With
# llm_provider=null the platform is fully functional and reports contain no
# generated prose at all.
LLM_PROVIDER=null
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- api -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
REQUIRE_API_KEY=false
# API_KEYS=key-one,key-two
RATE_LIMIT_PER_MINUTE=240
